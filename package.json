{
  "name": "instacart-ps-ds",
  "version": "0.1.0",
  "private": true,
  "description": "An unofficial, partly built Instacart design system for the workshop \"Make Claude follow and extend an existing design system\". For teaching only.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles/instacart.css",
    "./standalone.css": "./dist/instacart.standalone.css",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "sync:tokens": "node scripts/build-tokens.mjs",
    "storybook": "npm run sync:tokens && storybook dev -p 6006",
    "build-storybook": "npm run sync:tokens && storybook build -o storybook-static",
    "test": "npm run sync:tokens && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "npm run sync:tokens && npm run build:js && npm run build:types && npm run build:styles && npm run build:css",
    "build:js": "vite build -c vite.lib.config.ts",
    "build:types": "tsc -p tsconfig.build.json",
    "build:styles": "node scripts/copy-styles.mjs",
    "build:css": "tailwindcss -i ./src/styles/standalone.css -o ./dist/instacart.standalone.css --minify",
    "check:design": "node scripts/check-design/index.mjs",
    "check:design:calibrate": "node scripts/check-design/calibrate.mjs",
    "clean": "rm -rf dist storybook-static",
    "check:visual": "node scripts/visual-check/index.mjs",
    "build:guide": "node scripts/build-guide.mjs",
    "check:rules": "node scripts/check-rule-names.mjs"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.3.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.3",
    "@storybook/addon-docs": "^10.6.3",
    "@storybook/react-vite": "^10.6.3",
    "@tailwindcss/cli": "^4.0.0",
    "@tailwindcss/node": "^4.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "acorn": "^8.18.0",
    "jsdom": "^26.0.0",
    "playwright": "^1.63.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "storybook": "^10.6.3",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
